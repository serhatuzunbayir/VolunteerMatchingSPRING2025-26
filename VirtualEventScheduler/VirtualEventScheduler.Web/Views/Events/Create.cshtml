@model VirtualEventScheduler.Web.Models.EventCreateViewModel
@{ ViewData["Title"] = "Create Event"; }

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header py-3" style="background: linear-gradient(90deg, #2d1554 0%, #7b3fbf 100%);">
                <h4 class="mb-0 text-white fw-bold">Create New Event</h4>
            </div>
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small"></div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold small"></label>
                        <input asp-for="Title" class="form-control" placeholder="Event title" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold small"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"
                                  placeholder="Describe the event…"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DateTime" class="form-label fw-semibold small"></label>
                            <input asp-for="DateTime" type="datetime-local" class="form-control"
                                   value="@Model.DateTime.ToString("yyyy-MM-ddTHH:mm")" />
                            <span asp-validation-for="DateTime" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Capacity" class="form-label fw-semibold small"></label>
                            <input asp-for="Capacity" type="number" min="1" max="10000" class="form-control"
                                   placeholder="50" />
                            <span asp-validation-for="Capacity" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Location" class="form-label fw-semibold small"></label>
                        <input asp-for="Location" class="form-control"
                               placeholder="Zoom link / Address / Room number" />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-brand px-4">Create Event</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
