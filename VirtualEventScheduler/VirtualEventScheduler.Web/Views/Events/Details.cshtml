@model VirtualEventScheduler.Web.Models.EventViewModel
@{ ViewData["Title"] = Model.Title; }

@{
    var role = Context.Session.GetString("UserRole");
    var canManage = role == "Admin" || role == "Staff";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">
    <div class="col-md-8">
        <h2>@Model.Title</h2>
        <hr />
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Event Details</h5>
                <p class="card-text">@Model.Description</p>
                <dl class="row">
                    <dt class="col-sm-3">Date & Time</dt>
                    <dd class="col-sm-9">@Model.DateTime.ToString("dddd, MMMM dd, yyyy 'at' HH:mm")</dd>
                    <dt class="col-sm-3">Location</dt>
                    <dd class="col-sm-9">@Model.Location</dd>
                    <dt class="col-sm-3">Capacity</dt>
                    <dd class="col-sm-9">@Model.RegisteredCount / @Model.Capacity participants</dd>
                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-@(Model.Status == "Active" ? "success" : Model.Status == "Cancelled" ? "danger" : "secondary")">
                            @Model.Status
                        </span>
                        @if (Model.IsFull) { <span class="badge bg-warning">Full</span> }
                    </dd>
                </dl>
            </div>
        </div>

        @* Registration for attendees *@
        @if (Context.Session.GetString("Token") != null)
        {
            @if (!Model.IsFull && Model.Status == "Active")
            {
                <form asp-action="Register" asp-route-id="@Model.Id" method="post" class="mb-2">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success btn-lg">Register for this Event</button>
                </form>
            }
            else if (Model.IsFull)
            {
                <div class="alert alert-warning">This event is full. Registration is closed.</div>
            }
            else if (Model.Status == "Cancelled")
            {
                <div class="alert alert-danger">This event has been cancelled.</div>
            }
            else
            {
                <div class="alert alert-info">Registration is not available for this event.</div>
            }
        }
        else
        {
            <div class="alert alert-info">
                Please <a asp-controller="Account" asp-action="Login">login</a> to register for this event.
            </div>
        }

        @* Admin/Staff management buttons *@
        @if (canManage)
        {
            <div class="d-flex gap-2 mt-3 mb-3">
                @if (Model.Status != "Cancelled")
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit Event</a>
                    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger"
                                onclick="return confirm('Are you sure you want to cancel this event?')">
                            Cancel Event
                        </button>
                    </form>
                }
                <a asp-action="Participants" asp-route-id="@Model.Id" class="btn btn-info text-white">
                    View Participants (@Model.RegisteredCount)
                </a>
            </div>
        }

        <div class="mt-3">
            <a asp-action="Index" class="btn btn-secondary">Back to Events</a>
        </div>
    </div>
</div>
