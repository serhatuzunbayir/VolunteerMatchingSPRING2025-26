@model List<VirtualEventScheduler.Web.Models.ParticipantViewModel>
@{ ViewData["Title"] = "Participants - " + ViewBag.EventTitle; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Participants: @ViewBag.EventTitle</h2>
    <a asp-action="Details" asp-route-id="@ViewBag.EventId" class="btn btn-secondary">Back to Event</a>
</div>

<div class="card">
    <div class="card-header">
        <strong>Total registered: @Model.Count</strong>
    </div>
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="p-4 text-muted">No participants registered yet.</div>
        }
        else
        {
            <table class="table table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Registered At</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <tr>
                            <td>@(i + 1)</td>
                            <td>@Model[i].FullName</td>
                            <td>@Model[i].Email</td>
                            <td>@Model[i].RegisteredAt.ToString("MMM dd, yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
