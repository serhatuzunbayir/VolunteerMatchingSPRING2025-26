<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Virtual Event Scheduler</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark ve-navbar mb-3 shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Events" asp-action="Index">
                    🗓 VEvent Scheduler
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @{
                        var sessionRole = Context.Session.GetString("UserRole");
                        var sessionToken = Context.Session.GetString("Token");
                        var canManage = sessionRole == "Admin" || sessionRole == "Staff";
                        var isAdmin = sessionRole == "Admin";
                    }
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Events" asp-action="Index">Events</a>
                        </li>
                        @if (sessionToken != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Events" asp-action="MyEvents">My Events</a>
                            </li>
                        }
                        @if (canManage)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Events" asp-action="Create">+ Create Event</a>
                            </li>
                        }
                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Users">Users</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (sessionToken != null)
                        {
                            <li class="nav-item d-flex align-items-center me-2">
                                <span class="navbar-text text-white-50 me-1">
                                    @Context.Session.GetString("UserName")
                                </span>
                                <span class="badge rounded-pill bg-@(sessionRole == "Admin" ? "danger" : sessionRole == "Staff" ? "warning text-dark" : "light text-dark")">
                                    @sessionRole
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Logout">Logout</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm ms-2 my-auto" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <strong>✓</strong> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>✗</strong> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 Virtual Event Scheduler — SE 410 Project
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
